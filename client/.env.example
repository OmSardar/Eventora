# Eventora Client Configuration
# Production canonical site URL (e.g. https://eventora-black.vercel.app)
# If omitted on Vercel, automatically detected via process.env.VERCEL_URL
NEXT_PUBLIC_SITE_URL=https://eventora-black.vercel.app

# Public API Gateway URL (e.g. https://eventora-server-omslabs.onrender.com/api/v1)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Internal server-to-server API URL for Next.js SSR metadata / sitemap generation
INTERNAL_API_URL=http://localhost:5000/api/v1

# Razorpay Test Key for Frontend Checkout Modal (Accepts either RAZORPAY_KEY_ID or NEXT_PUBLIC_RAZORPAY_KEY_ID)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
