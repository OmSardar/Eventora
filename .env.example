# ==============================================================================
# EVENTORA — REPOSITORY-WIDE ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# This template documents all environment variables consumed across the
# Eventora platform. Never commit actual secret keys or credentials to version control.
# Copy appropriate sections into 'server/.env' and 'client/.env' respectively.
# ==============================================================================

# ==============================================================================
# 1. BACKEND REST API CONFIGURATION ('server/.env')
# Consumed by: server/src/app.js, server/src/server.js, and infrastructure modules
# ==============================================================================

# Server Network & Runtime
# PORT: Local HTTP port for the Express application (Render dynamically overrides via process.env.PORT)
PORT=5000
# NODE_ENV: 'development', 'test', or 'production' (controls logging verbosity, secure cookies, and auto-indexing)
NODE_ENV=development
# LOG_LEVEL: Pino logging detail ('debug', 'info', 'warn', 'error')
LOG_LEVEL=info

# Database Connection (MongoDB Atlas Clustered Replica Set or Local MongoDB)
# Note: Clustered replica sets are required in production for multi-document transaction support
MONGODB_URI=mongodb://127.0.0.1:27017/eventora

# Cross-Origin Resource Sharing (CORS) & Security
# Comma-separated list of allowed frontend origins (supports wildcards like https://*.vercel.app)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://eventora.omslabs.tech,https://eventora-black.vercel.app
# Primary frontend public URL for emails, password resets, and links
APP_BASE_URL=http://localhost:3000

# Session Management & Cryptography (Server-Only Secrets)
# Cryptographically secure random secret (min 32 characters) used to sign session cookies
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=eventora-super-secret-development-key-minimum-32-chars-long!
# Optional separate 32-byte key for AES-256-GCM TOTP secret encryption at rest. If omitted, derived from SESSION_SECRET.
MFA_ENCRYPTION_KEY=
# Cookie security settings (automatically 'true' when NODE_ENV=production)
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Account Security & Policy Flags
# Enforce email verification before creating events, registering, or checking out
ENFORCE_EMAIL_VERIFICATION=true
# Auto-verify demo/seed accounts during development or seeding
AUTO_VERIFY_TEST_ACCOUNTS=false

# Cloudinary Backend-Only Image Upload Integration (Server-Only Secrets)
# All image uploads are streamed directly to Cloudinary by the Express backend after binary magic-bytes verification
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Transactional Email Service (Server-Only Secret)
# Obtain your API key at https://resend.com/api-keys
RESEND_API_KEY=re_mock_test_key_for_development
# Verified sender address configured in your Resend account domain
EMAIL_FROM="Eventora <notifications@mail.example.com>"
EMAIL_REPLY_TO="support@mail.example.com"

# Razorpay Test Mode Payment Gateway Integration
# RAZORPAY_KEY_ID: Public key identifier for checkout modal (must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
# RAZORPAY_KEY_SECRET: Private API secret used exclusively on server for orders API & signature verification
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
# RAZORPAY_WEBHOOK_SECRET: Secret configured in Razorpay Dashboard -> Webhooks for HMAC-SHA256 verification
RAZORPAY_WEBHOOK_SECRET=YourDeveloperChosenWebhookSecretHere
# RAZORPAY_MODE: Strictly 'test' to guarantee test-mode operations
RAZORPAY_MODE=test

# ==============================================================================
# 2. FRONTEND CLIENT CONFIGURATION ('client/.env')
# Consumed by: client/src/lib/env.ts, Next.js App Router, and browser checkout
# ==============================================================================

# Production canonical site URL (used for sitemaps, canonical tags, and OpenGraph metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public REST API Gateway URL (accessed by client-side browser fetch)
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Internal server-to-server API URL for Next.js SSR and metadata generation
INTERNAL_API_URL=http://localhost:5000/api/v1

# Public Razorpay Test Key ID for the browser checkout modal (Must match RAZORPAY_KEY_ID above)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# Social Links (Optional)
NEXT_PUBLIC_TWITTER_URL=https://x.com/eventora
NEXT_PUBLIC_GITHUB_URL=https://github.com/OmSardar/Eventora

