# ==============================================================================
# Eventora Client Configuration Template ('client/.env')
# ==============================================================================

# Production canonical site URL (e.g. https://eventora.omslabs.tech or http://localhost:3000)
# Used for sitemap.xml, robots.txt, canonical links, and OpenGraph social metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Public REST API Gateway URL (accessed by browser API client)
# Production: https://eventora-server-omslabs.onrender.com/api/v1
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Internal server-to-server API URL for Next.js SSR and sitemap generation
INTERNAL_API_URL=http://localhost:5000/api/v1

# Razorpay Test Key ID for the browser checkout modal (Must match backend RAZORPAY_KEY_ID)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere

# Optional Social Brand Links
NEXT_PUBLIC_TWITTER_URL=https://x.com/eventora
NEXT_PUBLIC_GITHUB_URL=https://github.com/OmSardar/Eventora
