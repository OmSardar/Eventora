# Eventora Client Configuration
# Production canonical site URL (Never hardcode localhost in production)
NEXT_PUBLIC_SITE_URL=https://eventora.example.com

# Public API Gateway URL
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Internal server-to-server API URL for Next.js SSR metadata / sitemap generation
INTERNAL_API_URL=http://localhost:5000/api/v1
