PORT=5000
NODE_ENV=development
LOG_LEVEL=info

MONGODB_URI=mongodb://127.0.0.1:27017/eventora
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
APP_BASE_URL=http://localhost:3000

# Use this command for generating 'SESSION_SECRET' -> node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=eventora-super-secret-development-key-minimum-32-chars-long!

# Cloudinary Backend-Only Image Upload Integration (All uploads & credentials managed exclusively by Express backend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Resend Transactional Email Configuration (Official API)
# Get your API key at https://resend.com/api-keys
RESEND_API_KEY=re_mock_test_key_for_resend
# Sender domain must be verified in your Resend account before production delivery
EMAIL_FROM="Eventora <notifications@mail.example.com>"

# Razorpay Test Mode Payment Gateway Integration
# Key ID: Public key identifier for checkout modal (must start with rzp_test_)
RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
# Key Secret: Private API secret from Dashboard -> API Keys (used for orders API & checkout verification)
RAZORPAY_KEY_SECRET=YourTestKeySecretHere
# Webhook Secret: Distinct secret chosen when registering webhook in Dashboard -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YourDeveloperChosenWebhookSecretHere
# Mode: Must be 'test' to guarantee test-mode operations
RAZORPAY_MODE=test
