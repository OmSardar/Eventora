PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/eventora
SESSION_SECRET=eventora-super-secret-development-key-minimum-32-chars-long!
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_LEVEL=info

# Cloudinary Direct Signed Upload Integration (Backend Only - NEVER expose API Secret to Frontend)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Razorpay Payment Gateway Integration (Production / Test Keys)
RAZORPAY_KEY_ID=rzp_test_placeholder_key_id
RAZORPAY_KEY_SECRET=rzp_test_placeholder_key_secret
RAZORPAY_WEBHOOK_SECRET=rzp_test_placeholder_webhook_secret
MOCK_PAYMENTS=false
SEAT_HOLD_TTL_MINUTES=10

# MSG91 Transactional SMS Gateway Integration (Flow API India)
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_SENDER_ID=EVNTRA
MSG91_FLOW_ID_CONFIRMATION=flow_booking_confirmed_placeholder
MSG91_FLOW_ID_CANCELLATION=flow_booking_cancelled_placeholder
MSG91_FLOW_ID_REFUND=flow_refund_processed_placeholder
MOCK_SMS=false
